{
  "name": "ratchet",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"**/*.test.ts\"",
    "roms:fetch": "node scripts/roms-fetch.ts",
    "core:bundle": "node scripts/core-bundle.ts",
    "suites": "node suites/run.ts",
    "oracle:smoke": "node oracle/smoke.ts",
    "game:build": "sh game/build.sh",
    "lockstep": "node -e \"console.error('not built: S5');process.exit(1)\"",
    "replay": "node -e \"console.error('not built: S5');process.exit(1)\"",
    "dev": "node ui/dev.ts",
    "dev:fixtures": "node ui/dev.ts --fixtures",
    "ui:fixtures": "node ui/fixtures/make.ts",
    "play": "node -e \"console.error('not built: S7');process.exit(1)\"",
    "loop:once": "node -e \"console.error('not built: S8');process.exit(1)\"",
    "steer": "node -e \"console.error('not built: S8');process.exit(1)\"",
    "veto": "node -e \"console.error('not built: S8');process.exit(1)\"",
    "campaign": "node -e \"console.error('not built: S10');process.exit(1)\"",
    "vread": "node -e \"console.error('not built: S10');process.exit(1)\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.25.10",
    "typescript": "^5.7.0",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "pngjs": "7.0.0"
  }
}
