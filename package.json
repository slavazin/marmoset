{
  "name": "ratchet",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"**/*.test.ts\"",
    "roms:fetch": "node scripts/roms-fetch.ts",
    "core:bundle": "node scripts/core-bundle.ts",
    "suites": "node suites/run.ts",
    "oracle:smoke": "node oracle/smoke.ts",
    "game:build": "sh game/build.sh",
    "lockstep": "node lockstep/run.ts",
    "replay": "node tools/replay.mjs",
    "dev": "node ui/dev.ts",
    "dev:fixtures": "node ui/dev.ts --fixtures",
    "ui:fixtures": "node ui/fixtures/make.ts",
    "play": "node --env-file-if-exists=.env player/cli.ts",
    "spot": "node player/spot.ts",
    "replay:run": "node server/replay-run.ts",
    "replay:fixtures": "node server/replay-run.ts prerun --fixtures",
    "telemetry:verify": "node server/verify.ts",
    "telemetry:fixtures": "node ui/fixtures/make-telemetry.ts",
    "loop:once": "node loop/once.ts",
    "steer": "node loop/steer.ts steer",
    "veto": "node loop/steer.ts veto",
    "slow": "node loop/slow.ts",
    "campaign": "node -e \"console.error('not built: S10');process.exit(1)\"",
    "vread": "node -e \"console.error('not built: S10');process.exit(1)\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.25.10",
    "typescript": "^5.7.0",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "@google/genai": "3.0.0",
    "pngjs": "7.0.0"
  }
}
